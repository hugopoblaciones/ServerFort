\chapter{Servicios}

\begin{itemize}
  \item \textbf{DNS y DHCP}: resolución de nombres y configuración automática de la red. \completar{programas usados}
  \item \textbf{SSH}: administración remota con claves.
  \item \textbf{Web}: Apache con HTTPS, en la DMZ. \completar{certificado y dominio}
  \item \textbf{Archivos}: Samba con permisos por usuario y grupo, para que cada usuario solo vea sus cosas.
  \item \textbf{VPN}: WireGuard para conectarse desde fuera de forma segura.
\end{itemize}

